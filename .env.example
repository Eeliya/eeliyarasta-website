# Photo uploads from the editor to Cloudflare R2 (dev server only, never sent to the browser).
# Copy this file to .env.local (git-ignored), fill it in and restart `npm run dev`.

# Cloudflare dashboard > R2 > Account details: Account ID
R2_ACCOUNT_ID=
# R2 > Manage API tokens > Create API token (Object Read & Write, this bucket only): Access Key ID
R2_ACCESS_KEY_ID=
# Same token: Secret Access Key (shown once)
R2_SECRET_ACCESS_KEY=
# The bucket's name, e.g. eeliyarasta-photos
R2_BUCKET=
# Optional: another S3 endpoint instead of https://<account>.r2.cloudflarestorage.com (tests)
# R2_ENDPOINT=
# ---------------------------------------------------------------------------
# Contact form (functions/api/contact.js). NOT read from this file in production: set them in
# the Cloudflare Pages project > Settings > Variables and Secrets (Production and Preview).
# `npm run dev` doesn't need them: it answers /api/contact itself and only logs the message.
# For `npx wrangler pages dev dist`, put them in .dev.vars (git-ignored).
#
# Resend > API Keys > Create API key (Sending access): a secret
# RESEND_API_KEY=
# Where messages go (comma-separated for several); kept out of the public site
# CONTACT_TO=
# The sender: an address on a domain verified in Resend > Domains
# CONTACT_FROM=Website <contact@eeliyarasta.com>
# Optional, with site.json forms.turnstileSiteKey: Cloudflare Turnstile's secret key
# TURNSTILE_SECRET_KEY=
