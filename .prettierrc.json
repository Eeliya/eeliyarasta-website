{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    {
      "files": "src/site/**/*.js",
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
