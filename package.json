{
  "name": "eeliyarasta-website",
  "private": true,
  "version": "0.1.0",
  "description": "Eeliya Rasta: photography, projects and things. A tiny static site builder on Vite + GSAP.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/images.mjs && vite",
    "images": "node scripts/images.mjs",
    "build": "node scripts/images.mjs && vite build",
    "preview": "vite preview --port 4173",
    "test": "node --test scripts/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "lint": "eslint . && stylelint \"src/**/*.{scss,svelte}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{scss,svelte}\" --fix",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "license": "MIT",
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "aws4fetch": "^1.0.20",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svelte": "^5.57.2",
    "svelte-eslint-parser": "^1.9.0",
    "vite": "^8.3.4"
  }
}
