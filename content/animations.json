{
  "_comment": "Single source of truth for every animation on the site. Elements opt in with data-anim=\"<target id>\". spec = defaults <- presets[preset] <- targets[id] <- elements[key]. Edit by hand or with the visual editor at /edit/.",
  "defaults": { "duration": 1.1, "ease": "expo.out", "delay": 0, "stagger": 0, "trigger": "scroll", "start": "top 85%" },
  "presets": {
    "fade-up": {
      "type": "reveal",
      "from": { "autoAlpha": 0, "y": 40 },
      "to": { "autoAlpha": 1, "y": 0 }
    },
    "fade-in": {
      "type": "reveal",
      "from": { "autoAlpha": 0 },
      "to": { "autoAlpha": 1 },
      "ease": "power2.out"
    },
    "stagger-up": {
      "type": "reveal",
      "children": ":scope > *",
      "from": { "autoAlpha": 0, "y": 60 },
      "to": { "autoAlpha": 1, "y": 0 },
      "stagger": 0.08
    },
    "image-reveal": {
      "type": "reveal",
      "from": { "clipPath": "inset(100% 0% 0% 0%)", "scale": 1.15 },
      "to": { "clipPath": "inset(0% 0% 0% 0%)", "scale": 1 },
      "duration": 1.4,
      "ease": "expo.inOut"
    },
    "grid-reveal": {
      "type": "reveal",
      "children": "[data-anim-item]",
      "from": { "autoAlpha": 0, "y": 80, "clipPath": "inset(30% 0% 0% 0%)" },
      "to": { "autoAlpha": 1, "y": 0, "clipPath": "inset(0% 0% 0% 0%)" },
      "duration": 1.3,
      "stagger": 0.09,
      "start": "top 90%"
    },
    "split-chars": {
      "type": "split",
      "split": "chars",
      "mask": "chars",
      "from": { "yPercent": 110 },
      "to": { "yPercent": 0 },
      "duration": 1.2,
      "stagger": 0.035,
      "ease": "expo.out"
    },
    "split-lines": {
      "type": "split",
      "split": "lines",
      "mask": "lines",
      "from": { "yPercent": 105 },
      "to": { "yPercent": 0 },
      "duration": 1.1,
      "stagger": 0.08
    },
    "scrub-words": { "type": "scrub-words", "fromOpacity": 0.14, "start": "top 80%", "end": "bottom 45%" },
    "parallax": { "type": "parallax", "speed": 12, "scrub": true },
    "scatter-drift": {
      "type": "scatter",
      "intro": { "duration": 1.6, "ease": "expo.out", "stagger": 0.07, "delay": 0.15, "fromScale": 0.6 },
      "drift": { "amplitude": 14, "rotation": 2.5, "minDuration": 5, "maxDuration": 9 },
      "mouse": { "strength": 34, "duration": 1.2 },
      "scroll": { "distance": 55 }
    },
    "hero-title": {
      "type": "hero-title",
      "split": "chars",
      "from": { "yPercent": 120, "rotate": 6 },
      "to": { "yPercent": 0, "rotate": 0 },
      "duration": 1.6,
      "stagger": 0.045,
      "delay": 0.25,
      "scroll": { "scale": 0.82, "autoAlpha": 0.15 }
    },
    "hover-preview": { "type": "hover-preview", "follow": 0.45, "rotate": 6 }
  },
  "targets": {
    "hero.photos": { "preset": "scatter-drift" },
    "hero.title": { "preset": "hero-title" },
    "hero.meta": { "preset": "fade-up", "trigger": "load", "delay": 1.1, "duration": 1.2 },
    "home.intro": { "preset": "scrub-words" },
    "section.label": { "preset": "fade-up", "duration": 0.9 },
    "section.title": { "preset": "split-lines" },
    "home.people.grid": { "preset": "grid-reveal" },
    "home.places.grid": { "preset": "grid-reveal", "stagger": 0.15 },
    "place.card.image": { "preset": "parallax", "speed": 10 },
    "projects.list": { "preset": "stagger-up", "stagger": 0.06 },
    "projects.preview": { "preset": "hover-preview" },
    "page.title": { "preset": "split-chars", "trigger": "load", "delay": 0.1 },
    "page.intro": { "preset": "fade-up", "trigger": "load", "delay": 0.45 },
    "album.grid": { "preset": "grid-reveal", "trigger": "load", "delay": 0.3 },
    "album.title": { "preset": "split-chars", "trigger": "load", "delay": 0.15, "stagger": 0.03 },
    "album.meta": { "preset": "stagger-up", "trigger": "load", "delay": 0.4, "stagger": 0.05, "duration": 0.9 },
    "album.stage": { "preset": "image-reveal", "trigger": "load", "delay": 0.1 },
    "album.thumbs": { "preset": "stagger-up", "trigger": "load", "delay": 0.6, "stagger": 0.04, "duration": 0.8 },
    "about.image": { "preset": "image-reveal", "trigger": "load", "delay": 0.2 },
    "about.headline": { "preset": "split-lines", "trigger": "load", "delay": 0.2 },
    "about.body": { "preset": "stagger-up", "stagger": 0.1 },
    "footer.cta": { "preset": "split-lines", "start": "top 90%" },
    "footer.cols": { "preset": "stagger-up", "start": "top 95%" }
  },
  "_elementsComment": "Per-element overrides keyed by \"<page path>|<target id>|<n>\" (n = nth element with that target on the page). Any value, including \"preset\", can be overridden. Written by the visual editor (/edit/).",
  "elements": {},
  "interactions": {
    "cardCycle": { "interval": 0.75 },
    "album": { "wheelThreshold": 40, "wheelLock": 0.9, "dragThreshold": 50 }
  },
  "transitions": {
    "page": {
      "leave": {
        "to": { "autoAlpha": 0, "y": -40 },
        "duration": 0.55,
        "ease": "power3.in"
      },
      "enter": {
        "from": { "autoAlpha": 0, "y": 60 },
        "duration": 1,
        "ease": "expo.out"
      },
      "curtain": true
    },
    "accent": { "duration": 1.2, "ease": "power2.inOut" },
    "album": {
      "slide": { "duration": 1, "ease": "expo.inOut" },
      "view": { "duration": 0.9, "ease": "expo.inOut" }
    },
    "menu": {
      "open": { "duration": 0.6, "ease": "expo.out", "stagger": 0.04 },
      "close": { "duration": 0.35, "ease": "power2.in" }
    }
  }
}
